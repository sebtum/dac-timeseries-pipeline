    {
      "id": 9,
      "type": "barchart",
      "title": "Excluded readings by reason",
      "description": "Readings the cleaning step excluded, counted per experiment and reason. An experiment with no exclusions has no bar.",
      "datasource": {
        "type": "influxdb",
        "uid": "${influx}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${influx}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH w(experiment_id, t0, t1) AS (VALUES ${windows:raw}) SELECT r.experiment_id, r.reason, COUNT(*) AS readings FROM readings_processed r JOIN w ON r.experiment_id = w.experiment_id WHERE r.policy_version = '${policy_version}' AND r.verdict = 'excluded' AND r.time >= '${span_from}' AND r.time < '${span_to}' AND CAST(r.time AS BIGINT) >= w.t0 AND CAST(r.time AS BIGINT) < w.t1 GROUP BY r.experiment_id, r.reason ORDER BY r.experiment_id, r.reason"
        }
      ],
