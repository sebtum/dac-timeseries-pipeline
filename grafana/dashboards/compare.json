        "definition": "SELECT string_agg('(''' || experiment_id || ''', ' || ((extract(epoch FROM start_time) * 1000000)::bigint * 1000)::text || ', ' || ((extract(epoch FROM end_time) * 1000000)::bigint * 1000)::text || ')', ', ' ORDER BY experiment_id) AS windows FROM ${pg_schema}.experiment WHERE experiment_id IN (${experiment:sqlstring})",
        "query": "SELECT string_agg('(''' || experiment_id || ''', ' || ((extract(epoch FROM start_time) * 1000000)::bigint * 1000)::text || ', ' || ((extract(epoch FROM end_time) * 1000000)::bigint * 1000)::text || ')', ', ' ORDER BY experiment_id) AS windows FROM ${pg_schema}.experiment WHERE experiment_id IN (${experiment:sqlstring})",
