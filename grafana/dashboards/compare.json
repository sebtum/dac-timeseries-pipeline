      "description": "Derived metric series, one line per selected experiment, x = minutes since that experiment's start.",
      "datasource": {
        "type": "influxdb",
        "uid": "${influx}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${influx}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH w(experiment_id, t0, t1) AS (VALUES ${windows:raw}) SELECT r.experiment_id, (CAST(r.time AS BIGINT) - w.t0) / 60000000000.0 AS experiment_time_min, r.value FROM metrics_series r JOIN w ON r.experiment_id = w.experiment_id WHERE r.metric = '${metric}' AND r.metrics_version = '${metrics_version}' AND r.policy_version = '${policy_version}' AND r.time >= '${span_from}' AND r.time < '${span_to}' AND CAST(r.time AS BIGINT) >= w.t0 AND CAST(r.time AS BIGINT) < w.t1 ORDER BY r.experiment_id, r.time"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "experiment_id"
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "show": "lines",
            "lineWidth": 1,
            "pointSize": {
              "fixed": 3
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "experiment_time_min"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Minutes since start"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${__field.labels.experiment_id}"
              },
              {
                "id": "custom.axisLabel",
                "value": "Metric value"
              }
            ]
          }
        ]
      },
