    {
      "id": 8,
      "type": "table",
      "title": "Data quality per experiment",
      "description": "Completeness is readings present over readings expected, summed over the polled signals. Valid, bad and uncertain are shares of all readings of the experiment. Completeness and valid: green at 0.95 or more, amber at 0.5 or more, red below. Bad and uncertain: green below 0.05, amber below 0.5, red above.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${pg}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${pg}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT experiment_id, SUM(present) FILTER (WHERE expected IS NOT NULL)::float8 / NULLIF(SUM(expected), 0) AS completeness, SUM(accepted)::float8 / NULLIF(SUM(present), 0) AS valid_fraction, SUM(bad)::float8 / NULLIF(SUM(present), 0) AS bad_fraction, SUM(uncertain)::float8 / NULLIF(SUM(present), 0) AS uncertain_fraction FROM ${pg_schema}.signal_quality WHERE metrics_version = '${metrics_version}' AND experiment_id IN (${experiment:sqlstring}) GROUP BY experiment_id ORDER BY experiment_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
