# Copy this file to `.env` (gitignored) and fill in real values. Never commit `.env`.
#
# scripts/bootstrap_influx_token.py creates/updates .env from this template, preserving any
# keys already set, and fills in INFLUX_TOKEN once the admin token is minted.

# ---- InfluxDB ----
INFLUX_HOST=http://localhost:8181
INFLUX_PORT=8181
INFLUX_NODE_ID=node1
# Admin token. Left empty here; populated by scripts/bootstrap_influx_token.py. A real value
# must never be committed.
INFLUX_TOKEN=

# ---- Retention tiers (ADR-0011) ----
# Each tier carries two numbers: what this local/demo environment actually runs with, and the
# plant policy ADR-0011 defends. They are allowed to diverge — the init script (M1, later task)
# takes the value below as a parameter, not a constant, so dev and prod configuring differently
# is normal, not a shortcut.

# Local: 365d. All six experiment windows (2026-03-02 .. 2026-06-15, against an August 2026
#   wall clock) clear a full year of margin, so nothing here risks expiring silently mid-session
#   the way a naive 90-day window would have (MISTAKES.md C-06).
# Plant policy (ADR-0011): 9 months. A stakeholder default standing in for a lab-manager /
#   process-owner conversation that has not happened yet — defended as "how far back a
#   corrected cleaning policy can still reach before a bucket freezes into its rollup".
INFLUX_RAW_RETENTION=365d

# Local: 5y — comfortably longer than raw (365d), so the rollup outlives it the same way the
#   plant policy's rollup tier outlives its raw tier. No specific ratio to this number: there's
#   no real constraint tying it to a figure for local/demo data, just headroom.
# Plant policy (ADR-0011): 1 year — about 1.33x the 9-month raw window (12mo / 9mo), since the
#   rollup is the cheap, coarse record that outlives raw once a bucket has frozen.
INFLUX_ROLLUP_RETENTION=5y

# Local: unbounded (left empty). Pinned intervals-of-interest never expire, matching plant
#   policy exactly — there's no local-vs-plant tradeoff to make here.
# Plant policy (ADR-0011): none. A pin is a copy of a time range someone marked as interesting;
#   there is no sensible expiry for "this mattered enough to keep".
INFLUX_PINNED_RETENTION=

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dac
POSTGRES_USER=dac
POSTGRES_PASSWORD=changeme_local_only
