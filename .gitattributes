# Fixture bytes are hashed, so git must never convert their line endings (Windows vs the
# Linux CI runner). The committed .sha256 files match the LF bytes below.
tests/fixtures/** -text

# Migration files are hashed (pipeline/pg_migrate.py records a SHA-256 of the file bytes), so git
# must never convert their line endings: the recorded checksums are of the LF bytes, and a
# Windows checkout with core.autocrlf=true made the runner refuse 0001 (found in M4).
migrations/*.sql -text
