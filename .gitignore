data/raw/*.csv

# python
.venv/
__pycache__/
*.pyc

# secrets — bootstrapped locally by scripts/bootstrap_influx_token.py from .env.example,
# never committed (ADR-0009 exception 1)
.env

# influx/grafana local state if run via docker volumes here
influxdb-data/
grafana-data/

# editor swap/backup files
*.swp
*.swo
*~
_debrief/

# private verify-stack backup of a foreign .env (scripts/verify_stack.py)
.env.pre-verify

# flow verify scratch output (real-run profile checks write here)
.flow-tmp/
