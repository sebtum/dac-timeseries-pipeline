{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/dashboard_check.schema.json",
  "title": "dashboard_check.json",
  "description": "Shape of the summary that `python -m scripts.check_dashboards` writes (exit 0 and 1 only). Pins names and types, not behaviour. Times are UTC RFC 3339 strings ending in Z. The rules are M6 decision 8 and the M6 milestone in .workflow/dac.md. Owned by /flow:plan; changes are recorded under Decisions in .workflow/dac.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grafana_version",
    "source",
    "runs",
    "totals",
    "timing"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "grafana_version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dashboards",
        "overrides",
        "sweep",
        "time_range",
        "allow_empty"
      ],
      "properties": {
        "dashboards": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^:]+[.]json$"
          },
          "description": "Repo-relative paths with forward slashes."
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Variables set with --var, by name."
        },
        "sweep": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Variable names given with --sweep."
        },
        "time_range": {
          "enum": [
            "window",
            "span",
            "fixed"
          ]
        },
        "allow_empty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Panel titles given with --allow-empty."
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "description": "Sorted by dashboard_uid, selection, sweep values, time_from.",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "totals": {
      "type": "object",
      "description": "panel_targets = with_rows + empty + empty_allowed + errors. A target with an error counts only under errors.",
      "additionalProperties": false,
      "required": [
        "runs",
        "panel_targets",
        "with_rows",
        "empty",
        "empty_allowed",
        "errors",
        "annotation_errors"
      ],
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "panel_targets": {
          "type": "integer",
          "minimum": 0
        },
        "with_rows": {
          "type": "integer",
          "minimum": 0
        },
        "empty": {
          "type": "integer",
          "minimum": 0
        },
        "empty_allowed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "annotation_errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timing": {
      "type": "object",
      "description": "The only part that may differ between two runs on the same data.",
      "additionalProperties": false,
      "required": [
        "seconds",
        "queries"
      ],
      "properties": {
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "queries": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"
    },
    "datasource": {
      "enum": [
        "influx",
        "pg"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dashboard_uid",
        "dashboard_title",
        "selection",
        "sweep",
        "time_from",
        "time_to",
        "panels",
        "annotations"
      ],
      "properties": {
        "dashboard_uid": {
          "type": "string",
          "minLength": 1
        },
        "dashboard_title": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1,
          "description": "Experiment ids, sorted."
        },
        "sweep": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Swept variables and their value in this run; empty without --sweep."
        },
        "time_from": {
          "$ref": "#/$defs/instant"
        },
        "time_to": {
          "$ref": "#/$defs/instant"
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "description": "Sorted by panel_id.",
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "annotations": {
          "type": "array",
          "description": "Sorted by name.",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "title",
        "type",
        "empty_allowed",
        "targets"
      ],
      "properties": {
        "panel_id": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "empty_allowed": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "description": "Sorted by ref_id.",
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "datasource",
        "rows",
        "fields",
        "error"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "minLength": 1
        },
        "datasource": {
          "$ref": "#/$defs/datasource"
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "description": "Total rows over all frames; 0 on error."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Field names in frame order."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "The server's error text, or null when the query succeeded."
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "datasource",
        "rows",
        "error"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "datasource": {
          "$ref": "#/$defs/datasource"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "The server's error text, or null when the query succeeded."
        }
      }
    }
  }
}
